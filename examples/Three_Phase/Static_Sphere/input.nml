&dns
ng(1:3) = 576, 540, 540
l(1:3) = 16., 15., 15.
gtype = 1, gr = 0.
cfl = 0.5, dtmax = 1.e9, dt_f = -1.
is_solve_ns = T, is_track_interface = F
inivel = 'uni'
is_wallturb = F, is_forced_hit = F
nstep = 60000, time_max = 100., tw_max = 0.1
stop_type(1:3) = T, F, F
restart = F, is_overwrite_save = T, nsaves_max = 0
icheck = 10, iout0d = 10, iout1d = 0, iout2d = 200, iout3d = 5000, isave = 5000
cbcvel(0:1,1:3,1) = 'D','N',  'N','N',  'N','N'
cbcvel(0:1,1:3,2) = 'D','N',  'D','D',  'N','N'
cbcvel(0:1,1:3,3) = 'D','N',  'N','N',  'D','D'
cbcpre(0:1,1:3)   = 'N','D',  'N','N',  'N','N'
bcvel(0:1,1:3,1) =  1.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,2) =  0.,0.,   0.,0.,   0.,0.
bcvel(0:1,1:3,3) =  0.,0.,   0.,0.,   0.,0.
bcpre(0:1,1:3)   =  0.,0.,   0.,0.,   0.,0.
bforce(1:3) = 0., 0., 0.
gacc(1:3) = 0., 0., 0.
dims(1:2) = 0, 0
/

&scalar
inisca          = 'zer'
cbcsca(0:1,1:3) = 'P','P',  'P','P',  'N','N'
bcsca(0:1,1:3)  =  0.,0. ,   0.,0. ,   0.,0.
ssource         = 0.
/

&two_fluid
inipsi            = 'zer'
cbcpsi(0:1,1:3)   = 'N','N',  'N','N',  'N','N'
cbcnor(0:1,1:3,1) = 'N','N',  'N','N',  'N','N'
cbcnor(0:1,1:3,2) = 'N','N',  'N','N',  'N','N'
cbcnor(0:1,1:3,3) = 'N','N',  'N','N',  'N','N'
bcpsi(0:1,1:3)    =  0.,0. ,   0.,0. ,   0.,0.
bcnor(0:1,1:3,1)  =  0.,0.,    0.,0.,    0.,0.
bcnor(0:1,1:3,2)  =  0.,0.,    0.,0.,    0.,0.
bcnor(0:1,1:3,3)  =  0.,0.,    0.,0.,    0.,0.
rho12(1:2)        =  1., 1.
mu12(1:2)         =  0.01, 0.01
theta             =  154.
sigma             =  0.
ka12(1:2)         =  0., 0.
cp12(1:2)         =  0., 0.
beta12(1:2)       =  0., 0.
psi_thickness_factor =  0.25
/

&contact_line
max_pseudo_iter = 5
dtau_cfl        = 0.3
alpha_min       = 0.5
/

&cudecomp
cudecomp_t_comm_backend = 0, cudecomp_is_t_enable_nccl = T, cudecomp_is_t_enable_nvshmem = T
cudecomp_h_comm_backend = 0, cudecomp_is_h_enable_nccl = T, cudecomp_is_h_enable_nvshmem = T
/

&particle
np       = 1
radius   = 0.5
rho_s    = 1.
ratiorho = 1.
u_ini    = 0.
v_ini    = 0.
w_ini    = 0.
x_ini    = 8
y_ini    = 7.5
z_ini    = 7.5
is_solve_nwtn_eulr = F
/

&collision_parameters
Nstretch = 8.0
dt_estim = 0.003
r_dtcol  = 50
en       = 0.97
et       = 0.10
muc      = 0.0
/

&particle_euler
eps_sol = 1.5
/
